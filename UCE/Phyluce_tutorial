#!/usr/bin/env python3
from Bio import SeqIO

with open("example.fna", "r") as infile:
    with open("outfile_example.fasta", "w") as outf:
        for seq in SeqIO.parse(infile, 'fasta'):
            seq.name = ""
            seq.description = ""
            outf.write(seq.format('fasta'))
print("Conversion complete!")

